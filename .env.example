# Copier ce fichier dans .env. Remplacer les valeurs d'exemple en production.
APP_ENV=dev
API_KEY=a-remplacer
# Mot de passe du conteneur PostgreSQL de docker-compose.yml, repris dans DATABASE_URL.
POSTGRES_PASSWORD=a-remplacer
DATABASE_URL=postgresql+psycopg://attrition:a-remplacer@127.0.0.1:5432/attrition
