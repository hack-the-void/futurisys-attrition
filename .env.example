# Copier ce fichier dans .env. Remplacer les valeurs d'exemple en production.
APP_ENV=dev
API_KEY=a-remplacer

# Mots de passe des deux comptes PostgreSQL (voir docs/BASE_DE_DONNEES.md#accès).
# POSTGRES_PASSWORD : propriétaire, utilisé par docker-compose.yml, create_db et l'import.
POSTGRES_PASSWORD=a-remplacer
# Rôle de l'API, créé par `python -m attrition_api.create_db --roles`.
API_DB_PASSWORD=a-remplacer

# URL de chaque compte. Garder 127.0.0.1 : sous Windows, localhost passe par IPv6.
DATABASE_URL=postgresql+psycopg://api_attrition:a-remplacer@127.0.0.1:5432/attrition
ADMIN_DATABASE_URL=postgresql+psycopg://attrition:a-remplacer@127.0.0.1:5432/attrition
